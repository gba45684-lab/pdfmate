# --- App ---
# Public origin of the deployed site (used for metadata, AI referer and the same-origin API check).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (auth + private cloud documents). Run supabase/schema.sql first. ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_STORAGE_BUCKET=documents

# --- AI PDF (server-side OpenRouter proxy) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
# Optional: OpenAI-compatible endpoint (defaults to https://openrouter.ai/api/v1).
OPENROUTER_BASE_URL=
# Optional comma-separated list of models clients may request. Empty = clients cannot choose.
OPENROUTER_ALLOWED_MODELS=

# --- Secure PDF worker (protect / optimize / Office to PDF) ---
# URL of the deployed worker (see worker/README.md) and its shared secret. The worker will not start without a token in production.
PDF_WORKER_URL=
PDF_WORKER_TOKEN=
# Max upload size accepted by the Next.js proxy (bytes). Vercel itself caps request bodies at ~4.5 MB.
PDF_PROXY_MAX_BYTES=26214400

# --- Direct browser -> worker uploads (removes the ~4.5 MB serverless body limit) ---
# Public HTTPS URL of the worker. When set, the app mints short-lived upload tokens and the browser uploads straight to the worker.
# Leave empty to keep using the same-origin /api/pdf/* proxy. Set the worker's ALLOWED_ORIGINS to your site origin(s).
PDF_WORKER_PUBLIC_URL=
# Contact email shown on the privacy page (optional).
NEXT_PUBLIC_CONTACT_EMAIL=

# --- Shared rate limiting (optional). Without these, limits are per server instance. ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
