    "@supabase/supabase-js": "2.117.2",
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/hin": "1.0.0",
    "jszip": "3.10.2",
    "next": "16.3.8",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.3.289",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.13.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "postcss": "8.5.28",
